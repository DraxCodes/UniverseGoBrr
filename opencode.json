{
  "$schema": "https://opencode.ai/config.json",
  "model": "surplus/deepseek-v4.1-flash-1017",
  "compaction": {
    "auto": true,
    "buffer": "20%",
    "keep": {
      "tokens": 12000
    }
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 32768
  },
  "provider": {
    "surplus": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Surplus Intelligence",
      "options": {
        "baseURL": "https://api.surplusintelligence.ai/min80/v1",
        "apiKey": "{env:SURPLUS_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash-1017": {
          "name": "DeepSeek 4.1 Flash 1017 (Surplus)",
          "limit": {
            "context": 250000,
            "output": 32000
          },
          "variants": {
            "low": {},
            "high": {}
          }
        },
        "deepseek-v4.1-flash": {
          "name": "DeepSeek 4.1 Flash (Surplus)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 250000,
            "output": 32000
          }
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash (Surplus)",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "cost": {
            "input": 0.04,
            "output": 0.078
          },
          "limit": {
            "context": 250000,
            "output": 32000
          }
        },
        "glm-5.3": {
          "name": "GLM 5.3 (Surplus)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 250000,
            "output": 32000
          },
          "variants": {
            "low": {},
            "high": {},
            "max": {}
          }
        },
        "qwen3.8-flash": {
          "name": "Qwen 3.8 Flash (Surplus)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 250000,
            "output": 32000
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (Surplus) - listed but unroutable at min80 on 2026-11-18; kept so seating it is an edit, not a guess",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 250000,
            "output": 32000
          }
        },
        "gemini-4-argon": {
          "name": "Gemini 4 Argon (Surplus)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 250000,
            "output": 32000
          }
        },
        "claude-haiku-4.5": {
          "name": "Claude Haiku 4.5 (Surplus)",
          "tool_call": true,
          "reasoning": false,
          "limit": {
            "context": 200000,
            "output": 32000
          }
        }
      }
    }
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "mistral",
      "effect": "deny"
    }
  ],
  "agents": {
    "task-orchestrator": {
      "model": "surplus/deepseek-v4.1-flash-1017#low"
    },
    "plan-architect": {
      "model": "surplus/deepseek-v4.1-flash-1017#high",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "quality-gatekeeper": {
      "model": "surplus/deepseek-v4.1-flash-1017#high",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "security-auditor": {
      "model": "surplus/glm-5.3#high",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "**/.env*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "**/*.pem",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "**/*.key",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "Remove-Item *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git reset --hard *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git clean *",
      "effect": "ask"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "setup-pre-commit",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "context-engineering",
      "effect": "deny"
    }
  ]
}
